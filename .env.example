# Copy to .env and fill in your own values.  Never commit .env.

# ── Required ──────────────────────────────────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Optional: speech-to-text ──────────────────────────────────────────────────
# https://console.groq.com/keys
# Without this the app falls back to local faster-whisper (slower, no key needed).
GROQ_API_KEY=gsk_your-key-here

# ── Optional: persistence ─────────────────────────────────────────────────────
# The app runs without MongoDB (ChromaDB only), but screening history, interview
# reports and JD deduplication all require it.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=resume_screening

# ── Optional: vector store location ───────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db

# ── Optional: model overrides ─────────────────────────────────────────────────
DEEPSEEK_V3_MODEL=deepseek/deepseek-chat-v3-0324

# ── Optional: retrieval funnel ────────────────────────────────────────────────
# Widening these improves full-list ranking at the cost of latency and tokens.
RETRIEVAL_TOP_K=75
CROSS_ENCODER_TOP_K=25
LLM_TOP_K=15

# ── Optional: rank-fusion weights (must be read together) ─────────────────────
RRF_K=60
FUSION_W_LLM=0.50
FUSION_W_CE=0.30
FUSION_W_VEC=0.20
