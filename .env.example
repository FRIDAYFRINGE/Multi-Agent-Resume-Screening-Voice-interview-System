# Copy to .env and fill in your own values.  Never commit .env.

# ── Required ──────────────────────────────────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Speech-to-text (STT) ───────────────────────────────────────────────────────
# Primary: AssemblyAI real-time streaming API (universal-3-5-pro)
# https://www.assemblyai.com/dashboard/home
ASSEMBLY_AI_API_KEY=your_assemblyai_api_key_here

# Provider selection: "assemblyai" (default) | "groq" | "local"
STT_PROVIDER=assemblyai

# Secondary cloud fallback: Groq Whisper large-v3 (https://console.groq.com/keys)
# Without API keys, the app falls back to local faster-whisper (CPU, no key needed).
GROQ_API_KEY=gsk_your-key-here

# ── Optional: persistence ─────────────────────────────────────────────────────
# The app runs without MongoDB (ChromaDB only), but screening history, interview
# reports and JD deduplication all require it.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=resume_screening

# ── Optional: vector store location ───────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db

# ── Optional: model overrides ─────────────────────────────────────────────────
DEEPSEEK_V3_MODEL=deepseek/deepseek-chat-v3-0324

# ── Optional: retrieval funnel ────────────────────────────────────────────────
# Widening these improves full-list ranking at the cost of latency and tokens.
RETRIEVAL_TOP_K=75
CROSS_ENCODER_TOP_K=25
LLM_TOP_K=15

# ── Optional: rank-fusion weights (must be read together) ─────────────────────
RRF_K=60
FUSION_W_LLM=0.50
FUSION_W_CE=0.30
FUSION_W_VEC=0.20
